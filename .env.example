# ---- Database ----
POSTGRES_USER=iq
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=iq

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://iq.example.com

# ---- Auth.js + Google OAuth ----
AUTH_SECRET=                # openssl rand -base64 32
AUTH_GOOGLE_ID=             # Google Cloud Console > Credentials > OAuth client (Web)
AUTH_GOOGLE_SECRET=
# Redirect URIs to register:
#   https://<your-subdomain>/api/auth/callback/google
#   http://localhost:34817/api/auth/callback/google

# ---- web <-> api ----
API_JWT_SECRET=             # openssl rand -base64 32 (same value for web and api)
ADMIN_EMAILS=you@gmail.com  # comma-separated

# ---- Ads ----
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_POPUNDER_COOLDOWN_HOURS=48
# Adsterra: copy from each ad unit's "Get code" in the Adsterra dashboard.
# Turn on only Banner, Native Banner and Popunder; set Popunder frequency to 1.
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=        # 300x250 banner: the key in atOptions
NEXT_PUBLIC_ADSTERRA_BANNER_SRC=        # 300x250 banner: the invoke.js URL (https://...)
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=        # native banner: the invoke.js URL
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER=  # native banner: the container-... div id
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=      # popunder: the script URL

# ---- Payments (VietQR + SePay webhook) ----
# SePay > Webhooks: URL https://<subdomain>/api/webhooks/sepay, auth type "API Key".
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=         # account number SePay watches (use a dedicated account)
SEPAY_BANK=                 # bank short name, e.g. MBBank, Vietcombank
SUBSCRIPTION_PRICE_VND=30000

# ---- Local dev host ports only (prod publishes none) ----
WEB_PORT=34817
API_PORT=38721
DB_PORT=45329
