# =====================================================================
# IQ Test web: paste into Dokploy > Environment (Docker Compose service)
# Production domain: iqtest.limcogito.com
# NEXT_PUBLIC_* are baked in at build time: redeploy after changing them.
# =====================================================================

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://iqtest.limcogito.com
# Contact email shown on /dieu-khoan and /bao-mat (Google OAuth consent screen needs these pages)
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Database (generate: openssl rand -base64 24) ----
POSTGRES_USER=iq
POSTGRES_PASSWORD=
POSTGRES_DB=iq

# ---- Secrets (generate each: openssl rand -base64 32) ----
AUTH_SECRET=
API_JWT_SECRET=

# ---- Google OAuth (console.cloud.google.com > Credentials > OAuth client ID, type Web) ----
# Authorized JavaScript origins: https://iqtest.limcogito.com
# Authorized redirect URI:       https://iqtest.limcogito.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Admin (/admin: review questions, unmatched transfers). Comma-separated Google emails ----
ADMIN_EMAILS=

# ---- Payments: VietQR + SePay webhook ----
# SePay > Webhooks: URL https://iqtest.limcogito.com/api/webhooks/sepay, incoming only, auth "API Key".
# SePay > payment code: prefix IQ, then 8 letters/digits. Use a bank account only for this site.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK=MBBank
SUBSCRIPTION_PRICE_VND=30000

# ---- Contact form (/lien-he): emails each message to CONTACT_TO_EMAIL ----
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# Port 587 uses STARTTLS, 465 uses SSL. Messages are also saved in the DB if sending fails.
CONTACT_TO_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Ads: Adsterra (same setup as the toolbox project) ----
# Keep false for the first deploy; set true once the Adsterra units below are filled in.
NEXT_PUBLIC_ADS_ENABLED=false
# Banners: paste only the https://... src from each unit's code, e.g. https://bauval.org/22/<32-char key>.
# 320x50 is required; 728x90 is used when the slot is at least 728px wide.
NEXT_PUBLIC_ADSTERRA_SRC_320X50=
NEXT_PUBLIC_ADSTERRA_SRC_728X90=
# Shared ad frame on the separate ad origin. limcogito.com must add https://iqtest.limcogito.com
# to ADS_FRAME_EXTRA_PARENTS, or browsers refuse to show the frame here.
# Empty = banners in a srcdoc iframe on this site instead.
NEXT_PUBLIC_ADSTERRA_FRAME_URL=https://ads.limcogito.com/ad-frame.html
# Popunder: only the https URL from its <script src="...">. Empty = off.
# Runs only on home and tips pages, never during a test; set its frequency cap to 1 in Adsterra too.
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=
# At most once every N hours per browser (and per account when logged in)
NEXT_PUBLIC_ADSTERRA_POPUNDER_EVERY_HOURS=48
# Never on the visitor's first page view (2 = from the second page on)
NEXT_PUBLIC_ADSTERRA_POPUNDER_FROM_PAGEVIEW=2

# ---- Local dev only (production publishes no host ports) ----
WEB_PORT=34817
API_PORT=38721
DB_PORT=45329
