# ---- Database ----
POSTGRES_USER=iq
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=iq

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://iq.example.com

# ---- Auth.js + Google OAuth ----
AUTH_SECRET=                # openssl rand -base64 32
AUTH_GOOGLE_ID=             # Google Cloud Console > Credentials > OAuth client (Web)
AUTH_GOOGLE_SECRET=
# Redirect URIs to register:
#   https://<your-subdomain>/api/auth/callback/google
#   http://localhost:34817/api/auth/callback/google

# ---- web <-> api ----
API_JWT_SECRET=             # openssl rand -base64 32 (same value for web and api)
ADMIN_EMAILS=you@gmail.com  # comma-separated

# ---- Ads ----
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_POPUNDER_COOLDOWN_HOURS=48
# NEXT_PUBLIC_ADSTERRA_* keys are added when ad slots are built (step 4)

# ---- Payments (SePay, step 3+) ----
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SUBSCRIPTION_PRICE_VND=30000

# ---- Local dev host ports only (prod publishes none) ----
WEB_PORT=34817
API_PORT=38721
DB_PORT=45329
